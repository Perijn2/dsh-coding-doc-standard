{
	"id": "modern",
	"languageVersions": ">=5.0",
	"policyLanguage": "typescriptJavascript",
	"extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
	"formatterOnly": true,
	"formatter": {
		"adapter": "stdin-binary",
		"checkMode": "stdout-diff",
		"label": "@biomejs/biome 2.5.12",
		"settingsKey": "formatTypescriptJavascript",
		"dependency": {
			"provider": "npm",
			"source": "plugin-node-modules",
			"package": "@biomejs/biome",
			"version": "2.5.12",
			"bin": "biome"
		},
		"args": ["format", "--stdin-file-path", "{path}", "--vcs-enabled=false"],
		"cleanExit": [0],
		"diagnostics": "stderr"
	},
	"preamble": {
		"shebang": true
	},
	"codec": {
		"headerSyntax": "block",
		"headerOpen": "/**",
		"headerClose": "*/",
		"continuation": "*",
		"tagSigil": "@",
		"unlabeled": "summary",
		"fields": {
			"author": ["@author", "Author:"],
			"summary": ["Summary:"],
			"description": ["Description:"],
			"usage": ["Usage:"],
			"changelog": ["Changelog:"],
			"notes": ["Notes:"]
		}
	}
}
