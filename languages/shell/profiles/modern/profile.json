{
	"id": "modern",
	"languageVersions": ">=0",
	"policyLanguage": "shell",
	"extensions": [".sh", ".bash"],
	"preamble": {
		"shebang": true
	},
	"codec": {
		"headerSyntax": "line",
		"headerToken": "#",
		"fields": {
			"author": "Author:",
			"summary": "Summary:",
			"description": "Description:",
			"usage": "Usage:",
			"changelog": "Changelog:",
			"notes": "Notes:"
		}
	},
	"units": {
		"provider": "tree-sitter",
		"grammar": "bash",
		"query": "queries/units.scm",
		"docBinding": {
			"syntax": "line",
			"token": "#"
		}
	}
}
