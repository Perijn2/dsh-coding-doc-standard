{
  "enabled": true,
  "languages": {
    "python": true,
    "typescriptJavascript": true,
    "rust": true,
    "cCpp": true,
    "dockerCompose": true
  },
  "formatters": {
    "python": "ruff",
    "typescriptJavascript": "biome",
    "rust": "rustfmt",
    "cCpp": "clang-format",
    "dockerCompose": "prettier"
  },
  "linters": {
    "python": ["ruff"],
    "typescriptJavascript": ["biome"],
    "rust": ["clippy"],
    "cCpp": ["clang-tidy"],
    "dockerCompose": ["yamllint"]
  },
  "composePatterns": [
    "compose.yaml",
    "compose.yml",
    "docker-compose.yaml",
    "docker-compose.yml",
    "compose.*.yaml",
    "compose.*.yml"
  ]
}
