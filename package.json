{
	"name": "coding-doc-standard",
	"version": "0.2.0",
	"description": "Bundle-loaded documentation and formatting enforcement for DeepSeek Harness.",
	"type": "module",
	"main": "./src/host/index.mjs",
	"exports": {
		".": "./src/host/index.mjs",
		"./client": "./src/client/index.js",
		"./bundle.patch.yml": "./bundle.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"bundle.patch.yml",
		"languages",
		"skill",
		"src",
		"scripts",
		"docs",
		"client.js",
		"README.md",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": "./bundle.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-settings-plugins"
			]
		}
	},
	"scripts": {
		"test": "node --test tests/**/*.test.mjs",
		"verify": "node scripts/verify/verify.mjs",
		"install:harness": "node scripts/install/install.mjs",
		"provision-tools": "node scripts/install/provision-tools.mjs",
		"verify:dsh": "node scripts/verify/verify-dsh-contract.mjs"
	},
	"dependencies": {
		"@biomejs/biome": "2.5.12",
		"prettier": "3.9.6",
		"tree-sitter-wasm": "2.0.1",
		"typescript": "5.9.3",
		"web-tree-sitter": "0.27.0"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/dsh-commands": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/dsh-llm": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/dsh-settings": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || ^0.2.0-rc.0",
		"@deepseek-ai/schemastery": "^3.18.1"
	},
	"engines": {
		"node": ">=20"
	},
	"license": "MIT"
}
