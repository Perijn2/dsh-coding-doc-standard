{
	"name": "coding-doc-standard",
	"version": "0.2.0",
	"description": "Bundle-loaded documentation and formatting enforcement for DeepSeek Harness.",
	"type": "module",
	"main": "./src/host/index.mjs",
	"exports": {
		".": "./src/host/index.mjs",
		"./client": "./src/client/index.js",
		"./bundle.patch.yml": "./bundle.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"bundle.patch.yml",
		"skill",
		"src",
		"scripts",
		"docs",
		"client.js",
		"README.md",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": "./bundle.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-settings-plugins"
			]
		}
	},
	"scripts": {
		"test": "node --test tests/**/*.test.mjs",
		"verify": "node scripts/verify.mjs",
		"install:harness": "node scripts/install.mjs",
		"provision-tools": "node scripts/provision-tools.mjs"
	},
	"dependencies": {
		"@biomejs/biome": "2.5.12",
		"prettier": "3.9.6"
	},
	"engines": {
		"node": ">=20"
	},
	"license": "MIT"
}
